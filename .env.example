# FlyAI local configuration
# FlyAI.exe/go run automatically creates .env from this file on first launch.

# Go dependency orchestration
ORCHESTRATION_ENABLE=true
DOCKER_DESKTOP_AUTO_START=true
DOCKER_START_TIMEOUT_SECONDS=180
DOCKER_HEALTH_TIMEOUT_SECONDS=300

# Local service ports
HUB_HTTP_PORT=9528
HUB_INGEST_PORT=19099
BRIDGE_HTTP_PORT=19089
# Start the WeChat bridge automatically with the saved robot account on launch.
BRIDGE_AUTOSTART=true
# Set false when running as a background service without a desktop browser.
OPEN_BROWSER=true
# Optional override for the Next.js static export directory.
WEB_DIST_PATH=

# MySQL container
MYSQL_IMAGE=mysql:8.4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=wechat
MYSQL_USER=wechat
MYSQL_PASSWORD=wechat
MYSQL_ROOT_PASSWORD=wechat-root

# Redis container (TTL rate limits and short-lived coordination state)
REDIS_ENABLE=true
REDIS_IMAGE=redis:7.4-alpine
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=flyai-redis
REDIS_DB=0

# WeChat bridge
WECHAT_HOST=127.0.0.1:19089
# Optional local Nuitka build. FlyAI also checks FlyAI-Bridge.exe in the project root and a sibling FlyAI-Bridge/dist directory.
BRIDGE_EXECUTABLE_PATH=
BRIDGE_DOWNLOAD_URL=
BRIDGE_SHA256=
BRIDGE_START_TIMEOUT_SECONDS=90
WECHAT_DB_DIR=
BRIDGE_POLL_SECONDS=2
BRIDGE_BACKFILL=true
BRIDGE_BACKFILL_BATCH_SIZE=1000
WECHAT_FORWARD=

# Bounded concurrency and backpressure
RECEIVE_WORKERS=4
RECEIVE_QUEUE_SIZE=1000
PLUGIN_WORKERS=4
PLUGIN_QUEUE_SIZE=500
SEND_QUEUE_SIZE=100
SYNC_QUEUE_SIZE=100

# Web and notification settings
SYSTEM_DOMAIN=http://127.0.0.1:9528
ALAPI_TOKEN=xxx
NEW_FRIEND_NOTIFY_ENABLE=false
NEW_FRIEND_NOTIFY_USERS=

# Defaults for newly discovered contacts/groups
DEFAULT_AI=false
DEFAULT_CHAT_RANK=true
DEFAULT_SUMMARY=false
DEFAULT_WELCOME=true
DEFAULT_NEWS=true
DEFAULT_HOT_TOP=false
DEFAULT_AI_FREE_LIMIT=50

# Scheduled jobs. Feature push times can also be changed in the web UI.
TASK_ENABLE=true
TASK_NEWS_ENABLE=false
TASK_NEWS_CRON=0 8 * * *
TASK_HOT_TOP_ENABLE=false
TASK_HOT_TOP_CRON=0 */1 * * *
TASK_SYNC_FRIENDS_ENABLE=true
TASK_SYNC_FRIENDS_CRON=*/1 * * * *
TASK_GROUP_SUMMARY_ENABLE=false
TASK_GROUP_SUMMARY_CRON=30 0 * * *

# Optional RabbitMQ
MQ_ENABLE=false
MQ_HOST=127.0.0.1
MQ_PORT=5672
MQ_USER=wechat
MQ_PASSWORD=wechat
MQ_VHOST=wechat

# Existing chat-completion AI integration
AI_ENABLE=false
AI_MODEL=gpt-4o-mini
AI_SUMMARY_MODEL=gpt-4o-mini
AI_API_KEY=sk-xxxx
AI_BASE_URL=https://api.openai.com
AI_PERSONALITY=你是一个友好、简洁且可靠的群聊助手。

# Message resources
INTRODUCE_TEXT=大家好，我是一个群聊自动化助手，可以直接@我询问问题。
WELCOME_EMOTION_HASH=
WORDCLOUD_PATH=
INVITATION_REPLY=您的邀请消息已收到，管理员稍后会处理。
